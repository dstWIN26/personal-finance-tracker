# Keep the build context small and secret-free.
.git
.gitignore

# Secrets & runtime state (must never enter an image)
.env
.env.*
!.env.example
*.save
keys/
data/
*.db
*.sqlite
*.pem
*.key

# Python cruft
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Tests & docs aren't needed at runtime
tests/
agents/
*.md
!README.md

# OS
.DS_Store
