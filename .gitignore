# Secrets — never commit these
.env
.env.*
!.env.example
*.save
*.pem
*.key
keys/
secrets/

# Database
*.db
*.sqlite
*.sqlite3
data/

# Encrypted backup snapshots (still secrets — never commit)
backups/
*.tar.gz.enc

# Cloudflare Tunnel (local config written by setup-tunnel.sh; may contain the
# tunnel credentials-file path — keep out of git)
cloudflared/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
dist/
*.egg-info/
.pytest_cache/

# OS
.DS_Store
Thumbs.db
