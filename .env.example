# ─────────────────────────────────────────────────────────────
# Trade Republic (unofficial pytr) — SECURE KEYFILE MODE
# ─────────────────────────────────────────────────────────────
# Your phone number is required. Your PIN is NOT stored long-term.
# 1. Run once:  python -m backend.integrations.tr_setup
#    (enter PIN + the 4-digit OTP — this pairs the device & writes a keyfile)
# 2. Then DELETE the TRADE_REPUBLIC_PIN line below — it's no longer needed.
# All ongoing syncs authenticate with keys/tr_keyfile.pem, never the PIN.
TRADE_REPUBLIC_PHONE=+49XXXXXXXXXX
# TRADE_REPUBLIC_PIN=1234              # only for first-time pairing; remove after
TRADE_REPUBLIC_KEYFILE=keys/tr_keyfile.pem

# ─────────────────────────────────────────────────────────────
# Bank accounts via Enable Banking (recommended, FREE for personal use)
# ─────────────────────────────────────────────────────────────
# Links Revolut, Deutsche Bank and ~2,700 EEA banks. Read-only; you authenticate
# on the bank's own page — this app never sees your bank login. See LINKING.md.
# 1. Register an app at https://enablebanking.com and set its redirect URL to
#    https://<your-domain>/settings/banks/callback
# 2. Save the app's RSA private key to keys/enablebanking_private.pem (chmod 600)
# 3. Put the application id below, then link banks from the in-app Settings page.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEYFILE=keys/enablebanking_private.pem
# ENABLE_BANKING_REDIRECT_URL=          # optional; defaults to RP_ORIGIN + /settings/banks/callback
# ENABLE_BANKING_CONSENT_DAYS=90        # how long to request consent for (PSD2 caps this)

# Revolut via Salt Edge — LEGACY alternative (no free live tier; prefer Enable Banking)
# Get credentials at https://www.saltedge.com/clients/profile/secrets
SALTEDGE_APP_ID=your_app_id_here
SALTEDGE_SECRET=your_secret_here
# The two below are filled in after running:  python -m backend.integrations.revolut_setup
SALTEDGE_CUSTOMER_ID=
SALTEDGE_CONNECTION_ID=

# Email alerts (Gmail App Password recommended)
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
EMAIL_SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx  # Gmail App Password (16 chars)

# ─────────────────────────────────────────────────────────────
# Login / WebAuthn (passkey-only after first setup)
# ─────────────────────────────────────────────────────────────
# There is NO username/password env var. Login is a hardware passkey (Touch ID).
# One-time setup:  python -m backend.auth_setup   → sets a bootstrap password you
# use ONCE to log in and enrol your passkey; the password is then disabled.
#
# RP_ID   = your registrable domain, no scheme/port (passkeys are bound to it)
# RP_ORIGIN = the full https origin the browser sends
# In production these MUST be your real domain. For local dev the defaults
# (localhost / http://localhost:8000) work over http.
RP_ID=finance.example.com
RP_NAME=Finance Tracker
RP_ORIGIN=https://finance.example.com
SESSION_TTL_HOURS=12
# Used by Caddy for Let's Encrypt (optional but recommended for renewal notices):
ACME_EMAIL=you@example.com
# Optional brute-force tuning for the bootstrap password:
# MAX_PW_FAILURES=5
# LOCKOUT_MINUTES=15

# App config
PORT=8000
DB_PATH=finance.db
